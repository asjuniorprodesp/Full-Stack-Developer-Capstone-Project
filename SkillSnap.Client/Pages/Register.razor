@page "/register"
@inject SkillSnap.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<h1>Registrar</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageCss" role="alert">@message</div>
}

<EditForm Model="model" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Nome de usuário</label>
        <InputText class="form-control" @bind-Value="model.UserName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Senha</label>
        <InputText class="form-control" type="password" @bind-Value="model.Password" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nome completo (opcional)</label>
        <InputText class="form-control" @bind-Value="model.FullName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Imagem de perfil (opcional)</label>
        <InputText class="form-control" @bind-Value="model.ProfileImageUrl" />
    </div>

    <button class="btn btn-success" type="submit" disabled="@isBusy">
        @(isBusy ? "Registrando..." : "Registrar")
    </button>
</EditForm>

<p class="mt-3">
    Já tem conta? <a href="/login">Entrar</a>
</p>

@code {
    private SkillSnap.Client.Models.RegisterRequest model = new();
    private bool isBusy;
    private string? message;
    private string messageCss = "alert-info";

    private async Task HandleRegister()
    {
        isBusy = true;
        message = null;

        var result = await AuthService.RegisterAsync(model);
        if (!result.Success)
        {
            messageCss = "alert-danger";
            message = result.ErrorMessage ?? "Falha no registro.";
            isBusy = false;
            return;
        }

        messageCss = "alert-success";
        message = "Conta criada com sucesso. Faça login para continuar.";
        isBusy = false;
        Navigation.NavigateTo("/login");
    }
}
