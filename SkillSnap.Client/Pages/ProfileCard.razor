
<article class="profile-card section-card">
	<img class="profile-card__image" src="@ResolvedProfileImageUrl" alt="Foto de perfil de @Name" />
	<div class="profile-card__content">
		<h2>@Name</h2>
		<p>@(string.IsNullOrWhiteSpace(Bio) ? "Bio não informada. Este perfil ainda não tem uma descrição pública." : Bio)</p>
	</div>
</article>

@code {
	[Parameter] public string Name { get; set; } = "Perfil";
	[Parameter] public string Bio { get; set; } = string.Empty;
	[Parameter] public string ProfileImageUrl { get; set; } = string.Empty;

	private string ResolvedProfileImageUrl =>
		string.IsNullOrWhiteSpace(ProfileImageUrl)
			? "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=300&q=80"
			: ProfileImageUrl;
}

<style>
	.profile-card {
		display: grid;
		grid-template-columns: 88px 1fr;
		gap: 1.1rem;
		align-items: center;
		padding: 1.1rem;
		margin-bottom: 1rem;
	}

	.profile-card__image {
		width: 88px;
		height: 88px;
		object-fit: cover;
		border-radius: 999px;
		border: 3px solid #e9f2ff;
		background: #f1f5f9;
	}

	.profile-card__content h2 {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
	}

	.profile-card__content p {
		margin: 0;
		color: #4a4a4a;
		font-size: 0.97rem;
	}

	@@media (max-width: 640.98px) {
		.profile-card {
			grid-template-columns: 1fr;
			justify-items: start;
		}

		.profile-card__image {
			width: 72px;
			height: 72px;
		}
	}
</style>
